{
  "name": "bradley-portfolio-prototype",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "sharp": "0.35.0"
  },
  "scripts": {
    "dev": "node scripts/portfolio-dev.mjs",
    "build:avatar": "tsx scripts/avatar/build-bradley-avatar.ts",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "postbuild": "node --test tests/built-client-assets.test.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "setup:chat": "bash scripts/setup-portfolio-chat.sh",
    "setup:main-preview": "bash scripts/setup-main-preview.sh",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:dev-start": "node --test tests/dev-server-start.test.mjs",
    "test:worktree-bootstrap": "node --test tests/worktree-bootstrap.test.mjs",
    "test:rendered": "OPENAI_API_KEY=sk-client-leak-sentinel OPENAI_PORTFOLIO_MODEL=model-client-leak-sentinel PORTFOLIO_CHAT_IDENTIFIER_SECRET=identifier-secret-client-leak-sentinel TURNSTILE_SECRET_KEY=turnstile-secret-client-leak-sentinel npm run build && node --test tests/built-worker-chat.test.mjs tests/main-preview-worker-config.test.mjs tests/main-preview-workflow.test.mjs tests/preview-worker-config.test.mjs tests/rendered-html.test.mjs tests/rendered-routes.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern worker-configuration.main-preview.d.ts"
  },
  "dependencies": {
    "@openai/agents": "0.17.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "openai": "7.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.1",
    "@eslint/js": "9.39.4",
    "@gltf-transform/cli": "4.4.2",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.1.0",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "js-yaml": "4.1.1",
    "jsdom": "^29.1.1",
    "react-server-dom-webpack": "19.2.8",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "4.125.0"
  },
  "type": "module",
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
