{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bradley-portfolio-main-preview",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "bradleyberkman.com/*",
      "zone_name": "bradleyberkman.com"
    },
    {
      "pattern": "www.bradleyberkman.com/*",
      "zone_name": "bradleyberkman.com"
    },
    {
      "pattern": "insights.braininavat.dance/*",
      "zone_name": "braininavat.dance"
    }
  ],
  "triggers": {
    "crons": ["10 11 * * *"]
  },
  "vars": {
    "PORTFOLIO_CHAT_SESSION_REQUIRED": "true",
    "PORTFOLIO_CHAT_DAILY_REQUEST_LIMIT": "1000",
    "OPENAI_PORTFOLIO_MODEL": "gpt-5.6-sol",
    "OPENAI_PORTFOLIO_REASONING_EFFORT": "low",
    "OPENAI_PORTFOLIO_VERBOSITY": "low",
    "PORTFOLIO_FEEDBACK_ENABLED": "false",
    "PORTFOLIO_INSIGHT_EVENTS_SINK": "analytics-engine",
    "PORTFOLIO_INSIGHTS_HOST": "insights.braininavat.dance",
    "PORTFOLIO_INSIGHTS_ACCESS_TEAM": "maintain-dashboard.cloudflareaccess.com",
    "PORTFOLIO_INSIGHTS_ACCESS_EMAILS": "bradley@braininavat.dance",
    "PORTFOLIO_INSIGHTS_DAYS": "7"
  },
  "secrets": {
    "required": [
      "OPENAI_API_KEY",
      "PORTFOLIO_MAIN_PREVIEW_SESSION_SECRET",
      "PORTFOLIO_FEEDBACK_ADMIN_TOKEN",
      "PORTFOLIO_CHAT_IDENTIFIER_SECRET",
      "CLOUDFLARE_API_TOKEN",
      "CLARITY_API_TOKEN",
      "PORTFOLIO_INSIGHTS_AIRTABLE_TOKEN",
      "PORTFOLIO_INSIGHTS_ACCESS_AUD"
    ]
  },
  "ratelimits": [
    {
      "name": "PORTFOLIO_CHAT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 25, "period": 60 }
    },
    {
      "name": "PORTFOLIO_INSIGHT_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "r2_buckets": [
    {
      "binding": "PORTFOLIO_INSIGHTS_STORE",
      "bucket_name": "biv-portfolio-insights"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "PORTFOLIO_INSIGHTS",
      "dataset": "portfolio_insights"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PORTFOLIO_CHAT_BUDGET",
        "class_name": "PortfolioChatBudgetObject"
      },
      {
        "name": "PORTFOLIO_FEEDBACK",
        "class_name": "PortfolioFeedbackObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PortfolioChatBudgetObject"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["PortfolioFeedbackObject"]
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "no_bundle": true,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
